# Copy this file to `.env` and fill in the keys you actually plan to use.
# Every value has a safe default / graceful skip if left blank.

# --- News APIs ---------------------------------------------------------
NEWSAPI_KEY=
GNEWS_API_KEY=

# --- Social Media --------------------------------------------------------
# Only needed if you want the official Twitter/X API fallback
# (snscrape, the default path, needs no key at all).
TWITTER_BEARER_TOKEN=

# --- HTTP / scraping engine tuning --------------------------------------
REQUEST_TIMEOUT=15
REQUEST_RETRIES=3
REQUEST_BACKOFF_FACTOR=0.6
MIN_DELAY_BETWEEN_REQUESTS=1.0
RESPECT_ROBOTS_TXT=true
MAX_ARTICLES_PER_WEBSITE=20
MAX_TWEETS_PER_QUERY=50

# --- Logging -------------------------------------------------------------
LOG_LEVEL=INFO

# --- Section 2: AI Processing Pipeline -----------------------------------
# Translation backend: "dictionary" (offline) or "llm" (local OpenAI server)
TRANSLATION_BACKEND=dictionary
LOCAL_LLM_ENDPOINT=
LOCAL_LLM_MODEL=

# TTS backend: "auto" (xtts -> piper -> espeak -> placeholder)
TTS_BACKEND=auto
TTS_VOICE=ur
PIPER_MODEL_PATH=
XTTS_MODEL_PATH=
XTTS_SPEAKER_WAV=

# --- Section 3: Video Production Pipeline --------------------------------
# Gemini backend: Use GEMINI_API_KEY for Google Generative AI integration
GEMINI_API_KEY=

# Lip-sync backend: "auto" (wav2lip if GPU, else placeholder)
LIPSYNC_BACKEND=auto
WAV2LIP_CHECKPOINT=

# Video specs (defaults work for YouTube-ready 1080p output)
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30

# Urdu font (leave blank to auto-detect from system)
URDU_FONT_PATH=

# Channel branding
CHANNEL_NAME=اردو نیوز AI

# --- Section 4: Distribution & Automation Pipeline -------------------------
# YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_PRIVACY_STATUS=public
YOUTUBE_CATEGORY_ID=25

# Facebook / Meta Graph API
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=

# X / Twitter API v2
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Scheduler
SCHEDULER_INTERVAL_HOURS=4
SCHEDULER_TIMEZONE=UTC
SCHEDULER_MAX_RETRIES=3
SCHEDULER_RETRY_DELAY_MINUTES=30

# Mock mode (set to true for testing without real API credentials)
DISTRIBUTION_MOCK_MODE=false
