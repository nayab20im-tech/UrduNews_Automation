Dialogue: 0,0:00:00.00,0:00:03.39,Default,,0,0,0,,السلام علیکم ناظرین، میں آپ
Dialogue: 0,0:00:03.39,0:00:06.79,Default,,0,0,0,,کی میزبان ثناء ہوں اور
Dialogue: 0,0:00:06.79,0:00:10.18,Default,,0,0,0,,آپ دیکھ رہے ہیں آج
Dialogue: 0,0:00:10.18,0:00:12.22,Default,,0,0,0,,کی اہم خبریں۔
Dialogue: 0,0:00:12.22,0:00:15.62,Default,,0,0,0,,عمران خان کی ہسپتال منتقلی
Dialogue: 0,0:00:15.62,0:00:19.01,Default,,0,0,0,,کا معاملہ، تحریکِ انصاف نے
Dialogue: 0,0:00:19.01,0:00:22.41,Default,,0,0,0,,توہینِ عدالت کی درخواست دائر
Dialogue: 0,0:00:22.41,0:00:23.76,Default,,0,0,0,,کر دی۔۔
Dialogue: 0,0:00:23.76,0:00:27.16,Default,,0,0,0,,'بابو': وہ ایک لفظ جس
Dialogue: 0,0:00:27.16,0:00:30.56,Default,,0,0,0,,نے پولیس کو سکول پرنسپل
Dialogue: 0,0:00:30.56,0:00:33.27,Default,,0,0,0,,کے قاتلوں تک پہنچایا۔۔
Dialogue: 0,0:00:33.27,0:00:36.67,Default,,0,0,0,,متحدہ عرب امارات کے تجارتی
Dialogue: 0,0:00:36.67,0:00:40.06,Default,,0,0,0,,تعلقات منقطع کرنے کے فیصلے
Dialogue: 0,0:00:40.06,0:00:43.46,Default,,0,0,0,,سے ایران کو کتنا نقصان
Dialogue: 0,0:00:43.46,0:00:46.86,Default,,0,0,0,,ہوگا اور کیا تہران کے
Dialogue: 0,0:00:46.86,0:00:50.25,Default,,0,0,0,,پاس کا کوئی متبادل ہے؟۔
Dialogue: 0,0:00:50.25,0:00:53.65,Default,,0,0,0,,نرسنگ ہومز سے کانگریس تک:
Dialogue: 0,0:00:53.65,0:00:57.04,Default,,0,0,0,,امریکی کانگریس کا الیکشن جیتنے
Dialogue: 0,0:00:57.04,0:01:00.44,Default,,0,0,0,,والی پہلی افغان خاتون عائشہ
Dialogue: 0,0:01:00.44,0:01:02.48,Default,,0,0,0,,وہاب کون ہیں؟۔
Dialogue: 0,0:01:02.48,0:01:05.87,Default,,0,0,0,,وہ کہانی جس نے انسان
Dialogue: 0,0:01:05.87,0:01:09.27,Default,,0,0,0,,کے دل سے وہیل کا
Dialogue: 0,0:01:09.27,0:01:12.66,Default,,0,0,0,,ڈر ختم کر دیا: 'دولت
Dialogue: 0,0:01:12.66,0:01:16.06,Default,,0,0,0,,کی تلاش میں وہیل کے
Dialogue: 0,0:01:16.06,0:01:19.45,Default,,0,0,0,,شکار کی اصل وجہ انتقام
Dialogue: 0,0:01:19.45,0:01:20.13,Default,,0,0,0,,تھا'۔۔
Dialogue: 0,0:01:20.13,0:01:23.53,Default,,0,0,0,,خبر نمبر 1: خبر نمبر
Dialogue: 0,0:01:23.53,0:01:26.92,Default,,0,0,0,,2: خبر نمبر 3: خبر
Dialogue: 0,0:01:26.92,0:01:30.32,Default,,0,0,0,,نمبر 4: خبر نمبر 5:
Dialogue: 0,0:01:30.32,0:01:33.72,Default,,0,0,0,,مزید خبروں اور تازہ ترین
Dialogue: 0,0:01:33.72,0:01:37.11,Default,,0,0,0,,اپڈیٹس کے لیے ہمارے چینل
Dialogue: 0,0:01:37.11,0:01:39.15,Default,,0,0,0,,سے جڑے رہیں۔
