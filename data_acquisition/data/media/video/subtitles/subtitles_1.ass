Dialogue: 0,0:00:00.00,0:00:00.50,Default,,0,0,0,,آغاز: السلام علیکم ناظرین، خبروں
Dialogue: 0,0:00:00.50,0:00:01.00,Default,,0,0,0,,کے ساتھ ہم حاضر ہیں۔
Dialogue: 0,0:00:01.00,0:00:01.50,Default,,0,0,0,,عمران خان کی ہسپتال منتقلی
Dialogue: 0,0:00:01.50,0:00:02.00,Default,,0,0,0,,کا معاملہ، تحریکِ انصاف نے
Dialogue: 0,0:00:02.00,0:00:02.50,Default,,0,0,0,,توہینِ عدالت کی درخواست دائر
Dialogue: 0,0:00:02.50,0:00:03.00,Default,,0,0,0,,کر دی۔
Dialogue: 0,0:00:03.00,0:00:03.50,Default,,0,0,0,,پاکستان تحریکِ انصاف (پی ٹی
Dialogue: 0,0:00:03.50,0:00:04.00,Default,,0,0,0,,آئی) نے سابق وزیرِ اعظم
Dialogue: 0,0:00:04.00,0:00:04.50,Default,,0,0,0,,عمران خان کو ہسپتال منتقل
Dialogue: 0,0:00:04.50,0:00:05.00,Default,,0,0,0,,کرنے کے معاملے پر حکومت
Dialogue: 0,0:00:05.00,0:00:05.50,Default,,0,0,0,,کے خلاف توہینِ عدالت کی
Dialogue: 0,0:00:05.50,0:00:06.00,Default,,0,0,0,,درخواست دائر کر دی ہے۔
Dialogue: 0,0:00:06.00,0:00:06.50,Default,,0,0,0,,درخواست عزیر بھنڈاری اور سلمان
Dialogue: 0,0:00:06.50,0:00:07.00,Default,,0,0,0,,اکرم راجہ کی جانب سے
Dialogue: 0,0:00:07.00,0:00:07.50,Default,,0,0,0,,دائر کی گئی۔
Dialogue: 0,0:00:07.50,0:00:08.00,Default,,0,0,0,,توہینِ عدالت کی درخواست میں
Dialogue: 0,0:00:08.00,0:00:08.50,Default,,0,0,0,,عمران خان کو فوری طور
Dialogue: 0,0:00:08.50,0:00:09.00,Default,,0,0,0,,پر شفا انٹرنیشنل ہسپتال اسلام
Dialogue: 0,0:00:09.00,0:00:09.50,Default,,0,0,0,,آباد منتقل کرنے کی استدعا
Dialogue: 0,0:00:09.50,0:00:10.00,Default,,0,0,0,,کی گئی ہے۔
